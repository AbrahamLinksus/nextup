# Copy to .env and fill in. Every value here has a working default in
# assistant/config.py except the connector credentials.

# --- Postgres (docker compose up postgres brings this up on 5434) ---------
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant

# --- Models ---------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# "ollama" (no credentials, fully local) or "anthropic" (better structured
# tool-calling). Everything else is identical between them.
LLM_PROVIDER=ollama
OLLAMA_REASONING_MODEL=qwen2.5:7b-instruct-q4_K_M
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Gating ---------------------------------------------------------------
CLASSIFY_CONFIDENCE_THRESHOLD=0.80
FIELD_CONFIDENCE_THRESHOLD=0.75

# --- Connectors -----------------------------------------------------------
NOTION_API_KEY=
# Point at ops/mock_notion.py (http://localhost:8200) to run the whole pipeline
# against a fixture workspace with no Notion account at all.
NOTION_API_BASE=https://api.notion.com
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_TOPIC=

# --- Action execution -----------------------------------------------------
# Leave empty to keep every action a dry run (nothing is written to a real
# calendar). Set to an MCP server command to execute for real.
CALENDAR_MCP_COMMAND=
CALENDAR_MCP_ARGS=
CALENDAR_ID=primary

# --- Request authentication -----------------------------------------------
# Bind address. Anything other than loopback requires API_TOKEN to be set, or
# the server refuses to start rather than serve an open API.
API_HOST=127.0.0.1
API_PORT=8100

# Shared secret for the read/write API. Not user accounts -- there is one user;
# what needs protecting is the request, since /ask and /ingest spend model time
# and /queue/{id}/promote writes to a real calendar. Send it as
# `Authorization: Bearer <token>`; the dashboard prompts for it once.
# Optional while bound to loopback, required otherwise.
API_TOKEN=

# --- Webhook verification --------------------------------------------------
# Webhooks cannot use API_TOKEN -- Google has no way to learn it -- so each push
# source is verified the way it signs deliveries. Anything configured must pass.
# With nothing configured the endpoints refuse deliveries (503) unless
# WEBHOOK_ALLOW_UNVERIFIED is set.

# A secret in the push URL's query string: ...?token=<this>
WEBHOOK_TOKEN=

# Full OIDC verification of the Pub/Sub push token (RS256 against Google's
# JWKS, plus issuer, audience, and the service account allowed to deliver).
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# The token from Notion's subscription handshake -- it is the HMAC-SHA256 key
# the delivery body is signed with. Read it out of the api.notion_verification
# log line the first time Notion posts the handshake.
NOTION_WEBHOOK_SECRET=

# Local testing only. Turns the fail-closed rule above off.
WEBHOOK_ALLOW_UNVERIFIED=false
